{
  "schema_version": 1,
  "release_reference": "ShiftMate 10.0 release notes (YJDiary3/lib/lang/release_note_translations.dart)",
  "last_reviewed": "2026-10-13",
  "scope": "Known retired FAQ/Guide feature statements; not a substitute for manual release review",
  "rules": [
    {
      "id": "obsolete-feature-banner",
      "type": "faq",
      "locale": "ko",
      "pattern": "업데이트\\s*예정\\s*기능\\s*안내",
      "message": "The generic upcoming-feature section is retired."
    },
    {
      "id": "multidevice-still-planned",
      "type": "both",
      "locale": "ko",
      "pattern": "(?:다중\\s*기기|여러\\s*기기).{0,100}(?:지원(?:을)?\\s*준비|지원\\s*예정|동기화(?:를)?\\s*준비)",
      "message": "Multi-device shift sync is described as available in 10.0 release notes."
    },
    {
      "id": "tablet-still-planned",
      "type": "both",
      "locale": "ko",
      "pattern": "(?:태블릿|대화면).{0,80}(?:지원(?:을)?\\s*준비|지원\\s*예정|지원할\\s*예정)",
      "message": "Tablet/large-screen improvements are no longer an upcoming-only claim."
    },
    {
      "id": "viewer-management-still-planned",
      "type": "both",
      "locale": "ko",
      "pattern": "(?:공유\\s*관리|내\\s*근무\\s*공유).{0,80}(?:추가할\\s*예정|준비\\s*중)",
      "message": "Share-viewer management appears in 10.0 release notes."
    },
    {
